{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "string",
        "description": "Report format version."
      },
      "sourceSha256": {
        "type": "string",
        "description": "SHA-256 of the original UTF-8 CSV content."
      },
      "rows": {
        "type": "integer",
        "description": "Number of data records excluding the header."
      },
      "columns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Original exact header names."
      },
      "passedConfiguredChecks": {
        "type": "boolean",
        "description": "True only when no configured checks reported an error; warnings may remain. Does not certify store compatibility."
      },
      "summary": {
        "type": "object",
        "description": "Complete counts, even if issue details were truncated.",
        "properties": {
          "errors": {
            "type": "integer"
          },
          "warnings": {
            "type": "integer"
          },
          "affectedDataRecords": {
            "type": "integer"
          },
          "issuesTotal": {
            "type": "integer"
          },
          "issuesReturned": {
            "type": "integer"
          },
          "issuesTruncated": {
            "type": "boolean"
          },
          "byCode": {
            "type": "object"
          }
        }
      },
      "issues": {
        "type": "array",
        "description": "At most 500 issue details. Record numbering includes header as record 1.",
        "items": {
          "type": "object",
          "properties": {
            "record": {
              "type": [
                "integer",
                "null"
              ]
            },
            "column": {
              "type": [
                "string",
                "null"
              ]
            },
            "code": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "scope": {
        "type": "object",
        "description": "Rules applied to this CSV."
      }
    }
  },
  "views": {
    "overview": {
      "title": "Audit summary",
      "transformation": {
        "fields": [
          "rows",
          "passedConfiguredChecks",
          "summary.errors",
          "summary.warnings",
          "summary.affectedDataRecords",
          "summary.issuesTotal",
          "summary.issuesReturned",
          "summary.issuesTruncated",
          "sourceSha256"
        ],
        "flatten": [
          "summary"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "rows": {
            "label": "Data records",
            "format": "number"
          },
          "passedConfiguredChecks": {
            "label": "Passed checks",
            "format": "boolean"
          },
          "summary.errors": {
            "label": "Errors",
            "format": "number"
          },
          "summary.warnings": {
            "label": "Warnings",
            "format": "number"
          },
          "summary.affectedDataRecords": {
            "label": "Affected records",
            "format": "number"
          },
          "summary.issuesTotal": {
            "label": "Total issues",
            "format": "number"
          },
          "summary.issuesReturned": {
            "label": "Returned issues",
            "format": "number"
          },
          "summary.issuesTruncated": {
            "label": "Details truncated",
            "format": "boolean"
          },
          "sourceSha256": {
            "label": "Source SHA-256",
            "format": "text"
          }
        }
      }
    },
    "issues": {
      "title": "Issue details (up to 500)",
      "transformation": {
        "unwind": [
          "issues"
        ],
        "fields": [
          "record",
          "column",
          "severity",
          "code",
          "message"
        ]
      },
      "display": {
        "component": "table"
      }
    }
  }
}
